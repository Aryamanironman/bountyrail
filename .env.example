# PayPal sandbox — https://developer.paypal.com/dashboard/applications/sandbox
# Leave both blank to run in labelled demo mode (no network calls to PayPal).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox

# Public origin used for the PayPal return URL. Use your tunnel or deploy URL in the demo.
PUBLIC_BASE_URL=http://localhost:3100

# AI judge — any OpenAI-compatible chat completions endpoint.
# Default is Anthropic's OpenAI-compatible API; set a key to enable real model reviews.
AI_BASE_URL=https://api.anthropic.com/v1
AI_API_KEY=
AI_MODEL=claude-sonnet-5-5
# Nebius Token Factory alternative:
# AI_BASE_URL=https://api.tokenfactory.nebius.com/v1
# AI_MODEL=nvidia/Nemotron-3_5-Lightning

# GitHub webhook (Settings → Webhooks → Add webhook)
# Payload URL: <PUBLIC_BASE_URL>/api/webhooks/github, content type application/json
# Events: pull requests. Only merged PRs are reviewed.
GITHUB_WEBHOOK_SECRET=
GITHUB_TOKEN=

# Storage. Falls back to os.tmpdir() when the directory is not writable.
DATA_DIR=.data

# Set to true to disable POST /api/seed on a public deployment.
SEED_DISABLED=false

# Shown as the GitHub link in the header when set.
NEXT_PUBLIC_REPO_URL=
